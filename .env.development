# Biến thể DEBUG — `pnpm dev`, `pnpm db:push`, `pnpm db:seed` (không hậu tố).
# File này ĐƯỢC commit: không có bí mật, và nhờ nó clone về là chạy được ngay.
# Bí mật (AUTH_SECRET, CREDENTIAL_ENCRYPTION_KEY, SEED_ADMIN_*) nằm ở `.env`,
# dùng chung cho cả hai biến thể. Xem `.env.example`.

# SQLite trong thư mục dự án. Xoá file này là có DB sạch; chạy lại
# `pnpm db:push && pnpm db:seed` để dựng lại.
DATABASE_URL="file:./dev.db"
