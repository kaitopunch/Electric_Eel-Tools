{
  "name": "electric-eel",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.23.0",
  "scripts": {
    "dev": "prisma generate && next dev",
    "build": "NODE_ENV=production prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:push": "prisma db push",
    "db:push:release": "NODE_ENV=production prisma db push",
    "db:generate": "prisma generate",
    "db:generate:release": "NODE_ENV=production prisma generate",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:release": "NODE_ENV=production tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:studio:release": "NODE_ENV=production prisma studio",
    "validate:config": "tsx tools/validate-config.ts",
    "rotate:key": "tsx scripts/rotate-credential-key.ts",
    "rotate:key:release": "NODE_ENV=production tsx scripts/rotate-credential-key.ts",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "gen:templates": "node scripts/generate-native-templates.mjs",
    "gen:palette": "node scripts/generate-m3-palette.mjs"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.4.0",
    "@mui/material-nextjs": "^9.4.0",
    "@prisma/adapter-better-sqlite3": "^7.10.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@yume-chan/adb": "^2.6.4",
    "@yume-chan/adb-credential-web": "^2.1.0",
    "@yume-chan/adb-daemon-webusb": "^2.3.2",
    "@yume-chan/adb-scrcpy": "^2.3.2",
    "@yume-chan/adb-server-node-tcp": "^2.5.2",
    "@yume-chan/scrcpy": "^2.3.0",
    "@yume-chan/scrcpy-decoder-webcodecs": "^2.5.3",
    "bcryptjs": "^3.0.3",
    "google-auth-library": "^11.0.2",
    "next": "^16.3.3",
    "next-auth": "5.0.0-beta.32",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.5.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@material/material-color-utilities": "^0.4.0",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.3",
    "prisma": "7.10.0",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3"
  }
}
